# OpenTofu CLI configuration of the image, at `TF_CLI_CONFIG_FILE`.
#
# Providers are installed from the filesystem mirror the image build fills, and from nowhere else:
# there is deliberately no `direct {}` block, so a provider that is not baked in fails `tofu init`
# with "provider ... is not available" rather than being downloaded from a registry.
#
# A pipeline that brings its own CLI configuration replaces this file and has to carry the
# `provider_installation` block over, or `tofu init` falls back to downloading providers.
provider_installation {
  filesystem_mirror {
    path = "/usr/share/opentofu/providers"
  }
}
